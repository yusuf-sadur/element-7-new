# Element 7 — Environment Variables
# Copy this file to .env.local and fill in your values

# ─── Email (Resend) ───────────────────────────────────────────────────────────
# Get your free API key at https://resend.com
# Free tier: 100 emails/day, 3,000/month
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Email address to receive enquiries
CONTACT_EMAIL_TO=hello@element7.com.au

# Email address enquiries are sent FROM (must be a verified domain in Resend)
CONTACT_EMAIL_FROM=noreply@element7.com.au

# ─── Site ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://element7.com.au

# ─── Homepage hero video (optional) ───────────────────────────────────────────
# Place hero.mp4 in /public/videos/ or set a full URL to an MP4 asset
# NEXT_PUBLIC_HERO_VIDEO_MP4=/videos/hero.mp4
# NEXT_PUBLIC_HERO_VIDEO_WEBM=/videos/hero.webm
